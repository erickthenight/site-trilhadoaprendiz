                <i class="fa-solid fa-file-pdf text-4xl text-red-500 mb-4"></i>
                <h3 data-i18n="asset2_title" class="text-xl font-bold mb-2">Executive Pitch Deck</h3>
                <p data-i18n="asset2_desc" class="text-sm text-gray-400 mb-6">Resumo executivo do projeto C4-AMAZON, telemetria satelital e simulador MetaPorto.</p>
                <a href="#" class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-bold transition"><i class="fa-solid fa-download mr-2"></i> Download PDF</a>
            </div>

            <div class="bg-gray-900 p-6 rounded-xl border border-gray-800 hover:border-blue-500 transition">
                <i class="fa-solid fa-vr-cardboard text-4xl text-green-500 mb-4"></i>
                <h3 data-i18n="asset3_title" class="text-xl font-bold mb-2">Galeria MetaPorto XR</h3>
                <p data-i18n="asset3_desc" class="text-sm text-gray-400 mb-6">Imagens de alta qualidade do simulador, fluxo de inspeção NR e verificação Web 3.0.</p>
                <a href="#" class="inline-block bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-bold transition"><i class="fa-solid fa-download mr-2"></i> Download ZIP</a>
            </div>

        </div>
    </section>

    <section class="py-16 bg-black border-t border-gray-800 text-center">
        <div class="max-w-2xl mx-auto px-4">
            <h3 data-i18n="contact_title" class="text-2xl font-bold mb-6">Contato para Relações Públicas e Investidores</h3>
            <div class="bg-gray-900 p-6 rounded-xl border border-gray-800 inline-block text-left">
                <p class="text-white font-bold text-lg">Helen Araújo</p>
                <p class="text-gray-400 text-sm mb-4">Chief Legal Officer (CLO)</p>
                <p class="text-blue-400 flex items-center gap-2"><i class="fa-solid fa-envelope"></i> <a href="mailto:helen@yakami.com.br" class="hover:underline">helen@yakami.com.br</a></p>
            </div>
        </div>
    </section>

    <script>
        const translations = {
            pt: { 
                title: "Kit de Imprensa | YAKAMI TECH", hero_title: "Kit de Imprensa Oficial", hero_desc: "Materiais, logomarcas e resumos executivos oficiais para mídia e investidores sobre o ecossistema de Deep Tech.", 
                asset1_title: "Logomarcas Oficiais", asset1_desc: "Arquivos em alta resolução (PNG/SVG) da Yakami Tech e startup Trilha do Aprendiz.", 
                asset2_title: "Executive Pitch Deck", asset2_desc: "Resumo executivo do projeto C4-AMAZON, telemetria satelital e simulador MetaPorto.", 
                asset3_title: "Galeria MetaPorto XR", asset3_desc: "Imagens de alta qualidade do simulador, fluxo de inspeção NR e verificação Web 3.0.", 
                contact_title: "Contato para Relações Públicas e Investidores" 
            },
            en: { 
                title: "Press Kit | YAKAMI TECH", hero_title: "Official Press Kit", hero_desc: "Official materials, logos, and executive summaries for media and investors regarding the Deep Tech ecosystem.", 
                asset1_title: "Official Logos", asset1_desc: "High-resolution files (PNG/SVG) for Yakami Tech and the Trilha do Aprendiz startup.", 
                asset2_title: "Executive Pitch Deck", asset2_desc: "Executive summary of the C4-AMAZON project, satellite telemetry, and MetaPorto simulator.", 
                asset3_title: "MetaPorto XR Gallery", asset3_desc: "High-quality images of the simulator, NR inspection flow, and Web 3.0 verification.", 
                contact_title: "Public Relations & Investor Contact" 
            },
            zh: { 
                title: "新闻工具包 | YAKAMI TECH", hero_title: "官方新闻工具包", hero_desc: "面向媒体和投资者的深科技生态系统官方材料、徽标和执行摘要。", 
                asset1_title: "官方标志", asset1_desc: "Yakami Tech 和 Trilha do Aprendiz 初创公司的高分辨率文件 (PNG/SVG)。", 
                asset2_title: "执行商业计划书", asset2_desc: "C4-AMAZON 项目、卫星遥测和 MetaPorto 模拟器的执行摘要。", 
                asset3_title: "MetaPorto XR 图库", asset3_desc: "模拟器、NR 检查流程和 Web 3.0 验证的高质量图像。", 
                contact_title: "公共关系与投资者联系方式" 
            }
        };

        function changeLanguage(lang) {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });
        }
    </script>
</body>
</html>