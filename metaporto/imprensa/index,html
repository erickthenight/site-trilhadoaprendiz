            <div class="flex gap-2 bg-gray-900 border border-gray-700 p-1 rounded-lg">
                <button onclick="changeLanguage('pt')" class="hover:bg-gray-800 px-3 py-1 rounded text-sm transition">🇧🇷 PT</button>
                <button onclick="changeLanguage('en')" class="hover:bg-gray-800 px-3 py-1 rounded text-sm transition">🇺🇸 EN</button>
                <button onclick="changeLanguage('zh')" class="hover:bg-gray-800 px-3 py-1 rounded text-sm transition">🇨🇳 ZH</button>
            </div>
